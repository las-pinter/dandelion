# Dandelion operator settings. The systemd user unit reads this file through
# EnvironmentFile=-, so it is optional. Leave a setting commented to use the
# default.

# Public origin the browser opens. Without it the server reads the Tailscale
# DNS name from `tailscale status --json`. A plain-http value must be
# http://localhost (a WebAuthn relying party is a domain, never an IP).
# DANDELION_PUBLIC_URL=https://example-machine.example.ts.net

# Data directory. Default: $XDG_DATA_HOME/dandelion, else
# ~/.local/share/dandelion.
# DANDELION_DATA_DIR=/home/your-user/.local/share/dandelion

# Log filter for the service. Default: info.
# RUST_LOG=dandelion=debug
